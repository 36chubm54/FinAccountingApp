namespace ledgera_engine {};

[Error]
enum LedgeraEngineError {
    "Validation",
    "Storage",
};

dictionary RecordFilterDto {
    string? start_date;
    string? end_date;
    i64? wallet_id;
    string? record_type;
};

dictionary CreateRecordRequest {
    string record_type;
    string date;
    i64 wallet_id;
    string amount_original;
    string currency;
    string rate_at_operation;
    string amount_base;
    string category;
    string description;
    sequence<string> tags;
};

dictionary UpdateRecordRequest {
    string record_type;
    string date;
    i64 wallet_id;
    string amount_original;
    string currency;
    string rate_at_operation;
    string amount_base;
    string category;
    string description;
    sequence<string> tags;
};

dictionary CreateTransferRequest {
    i64 from_wallet_id;
    i64 to_wallet_id;
    string date;
    string amount;
    string currency;
    string description;
    string commission_amount;
    string commission_currency;
};

dictionary CreateTransferResult {
    i64 transfer_id;
};

dictionary UpdateTransferRequest {
    i64 from_wallet_id;
    i64 to_wallet_id;
    string date;
    string amount;
    string currency;
    string description;
};

dictionary UpdateTransferResult {
    i64 transfer_id;
};

dictionary CreateWalletRequest {
    string name;
    string currency;
    string initial_balance;
    boolean allow_negative;
};

dictionary WalletDeleteResultDto {
    i64 wallet_id;
    string action;
};

dictionary OperationDeleteResultDto {
    i64 deleted_records;
    i64 deleted_transfers;
    i64 skipped_records;
};

dictionary OperationImportResultDto {
    i64 imported;
    i64 skipped;
    sequence<string> errors;
    boolean dry_run;
};

dictionary OperationExportResultDto {
    i64 exported_rows;
    string path;
};

dictionary AuditFindingDto {
    string check;
    string severity;
    string message;
    string entity;
};

dictionary RecordDto {
    i64 id;
    string record_type;
    string date;
    i64 wallet_id;
    i64? transfer_id;
    i64? related_debt_id;
    string amount_original;
    string currency;
    string rate_at_operation;
    string amount_base;
    string category;
    string description;
    sequence<string> tags;
};

dictionary WalletDto {
    i64 id;
    string name;
    string currency;
    string initial_balance;
    boolean system;
    boolean allow_negative;
    boolean is_active;
};

dictionary TransferDto {
    i64 id;
    i64 from_wallet_id;
    i64 to_wallet_id;
    string date;
    string amount_original;
    string currency;
    string rate_at_operation;
    string amount_base;
    string description;
};

dictionary WalletBalanceDto {
    i64 wallet_id;
    string name;
    string currency;
    string balance;
};

dictionary EngineStatusDto {
    boolean ok;
    string db_path;
    string message;
};

interface LedgeraEngine {
    constructor(string db_path);

    EngineStatusDto engine_status();
    [Throws=LedgeraEngineError]
    string base_currency();
    [Throws=LedgeraEngineError]
    sequence<RecordDto> list_records(RecordFilterDto filter);
    [Throws=LedgeraEngineError]
    RecordDto? get_record(i64 record_id);
    [Throws=LedgeraEngineError]
    RecordDto create_record(CreateRecordRequest request);
    [Throws=LedgeraEngineError]
    RecordDto update_record(i64 record_id, UpdateRecordRequest request);
    [Throws=LedgeraEngineError]
    boolean delete_record(i64 record_id);
    [Throws=LedgeraEngineError]
    CreateTransferResult create_transfer(CreateTransferRequest request);
    [Throws=LedgeraEngineError]
    TransferDto? get_transfer(i64 transfer_id);
    [Throws=LedgeraEngineError]
    UpdateTransferResult update_transfer(i64 transfer_id, UpdateTransferRequest request);
    [Throws=LedgeraEngineError]
    boolean delete_transfer(i64 transfer_id);
    [Throws=LedgeraEngineError]
    OperationDeleteResultDto delete_all_operations();
    [Throws=LedgeraEngineError]
    OperationDeleteResultDto delete_operations_selection(sequence<i64> record_ids, sequence<i64> transfer_ids);
    [Throws=LedgeraEngineError]
    OperationImportResultDto preview_import_records_csv(string path);
    [Throws=LedgeraEngineError]
    OperationImportResultDto import_records_csv(string path);
    [Throws=LedgeraEngineError]
    OperationExportResultDto export_records_csv(string path);
    [Throws=LedgeraEngineError]
    sequence<string> list_tags();
    [Throws=LedgeraEngineError]
    sequence<string> list_categories(string record_type);
    [Throws=LedgeraEngineError]
    sequence<WalletDto> list_wallets();
    [Throws=LedgeraEngineError]
    WalletDto create_wallet(CreateWalletRequest request);
    [Throws=LedgeraEngineError]
    WalletDeleteResultDto delete_wallet(i64 wallet_id);
    [Throws=LedgeraEngineError]
    sequence<AuditFindingDto> audit_run();
    [Throws=LedgeraEngineError]
    sequence<WalletBalanceDto> wallet_balances();
    [Throws=LedgeraEngineError]
    WalletBalanceDto? wallet_balance(i64 wallet_id);
};
